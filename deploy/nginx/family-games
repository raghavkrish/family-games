# Family Games — nginx (HTTP + HTTPS)
#
# DNS: A/AAAA for games.raghavk.me and party.games.raghavk.me
#
# Install:
#   sudo cp deploy/nginx/family-games /etc/nginx/sites-available/family-games
#   sudo ln -sf /etc/nginx/sites-available/family-games /etc/nginx/sites-enabled/
#   sudo certbot --nginx -d games.raghavk.me -d party.games.raghavk.me
#   sudo nginx -t && sudo systemctl reload nginx
#
# App (.env on server, then npm run build && npm start):
#   HOST=127.0.0.1
#   PORT=3001
#   PARTYKIT_PORT=1999
#   NEXT_PUBLIC_PARTYKIT_PORT=
#   NEXT_PUBLIC_PARTYKIT_HOST=party.games.raghavk.me
#
# PartyKit stays on 127.0.0.1:1999 — do NOT open 1999 publicly.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream family_games_next {
    server 127.0.0.1:3001;
    keepalive 32;
}

upstream family_games_party {
    server 127.0.0.1:1999;
    keepalive 32;
}

# HTTP → HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name games.raghavk.me party.games.raghavk.me;
    return 301 https://$host$request_uri;
}

# Next.js (landing, host TV, phone UI)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name games.raghavk.me;

    # Managed by Certbot (uncomment if adding certs manually):
    # ssl_certificate     /etc/letsencrypt/live/games.raghavk.me/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/games.raghavk.me/privkey.pem;
    # include /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 10m;

    location / {
        proxy_pass http://family_games_next;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 60s;
    }
}

# PartyKit WebSockets (WSS on 443)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name party.games.raghavk.me;

    # ssl_certificate     /etc/letsencrypt/live/party.games.raghavk.me/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/party.games.raghavk.me/privkey.pem;
    # include /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://family_games_party;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
