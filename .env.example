# Next.js bind address & port (npm run dev / start)
HOST=0.0.0.0
PORT=3000

# Browser-facing PartyKit port (baked into the client at build time).
# Local/LAN: 1999
# HTTPS prod behind nginx on :443: leave empty
#   NEXT_PUBLIC_PARTYKIT_PORT=
NEXT_PUBLIC_PARTYKIT_PORT=1999

# Local / LAN fallback (client prefers window.location.hostname + port above).
# HTTPS production (rebuild after changing):
#   HOST=127.0.0.1
#   PORT=3001
#   PARTYKIT_PORT=1999
#   NEXT_PUBLIC_PARTYKIT_PORT=
#   NEXT_PUBLIC_PARTYKIT_HOST=party.games.raghavk.me
NEXT_PUBLIC_PARTYKIT_HOST=127.0.0.1:1999

# PartyKit process listen port when NEXT_PUBLIC_PARTYKIT_PORT is empty (nginx upstream).
# PARTYKIT_PORT=1999
