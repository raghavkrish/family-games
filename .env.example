# Next.js bind address & port (npm run dev / start)
HOST=0.0.0.0
PORT=3000

# PartyKit local port (must match what the browser uses)
NEXT_PUBLIC_PARTYKIT_PORT=1999

# Local fallback / cloud PartyKit host.
# For LAN play, the client prefers window.location.hostname + NEXT_PUBLIC_PARTYKIT_PORT.
# For a deployed PartyKit project, set e.g. your-project.username.partykit.dev
NEXT_PUBLIC_PARTYKIT_HOST=127.0.0.1:1999
